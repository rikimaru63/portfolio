---
import { site, mailto } from "../data/site";
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
const nav = [
  ["作った物", `${base}#work`],
  ["料金", `${base}#services`],
  ["触る", `${base}#demo`],
  ["進め方", `${base}#stack`],
];
---

<header class="hd">
  <a class="brand" href={base}>{site.brand}</a>
  <nav aria-label="ページ内">
    {nav.map(([label, href]) => <a class="link" href={href}>{label}</a>)}
  </nav>
  <a class="act" href={mailto()}>相談する</a>
</header>

<style>
  .hd { position: fixed; inset: 0 0 auto 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 64px; padding-inline: var(--margin); mix-blend-mode: normal; }
  .brand { font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; letter-spacing: -0.03em; }
  nav { display: flex; gap: 1.6rem; font-size: 0.9rem; color: var(--fg-2); }
  .act { font-size: 0.9rem; font-weight: 700; color: var(--accent); }
  @media (max-width: 47.99em) { nav { display: none; } }
</style>
